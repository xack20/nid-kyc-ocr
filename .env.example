GEMINI_API_KEY=your_gemini_api_key_from_aistudio
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
PORT=3000

# Model selection — uncomment one to override the default
# Available models:
#   gemini-3.1-pro-preview   ← default (latest, cutting-edge)
#   gemini-2.5-pro           (stable, best accuracy)
#   gemini-3.1-flash-lite    (fast, latest)
# GEMINI_MODEL=gemini-3.1-pro-preview

# Thinking level for all Gemini calls: minimal | low | medium | high (default: high)
# GEMINI_THINKING_LEVEL=high

# Smart adaptive mode
# Tier 1 parses Cloud Vision text only; Tier 2 verifies uncertain fields visually.
# SMART_TIER1_MODEL=gemini-3.1-flash-lite
# SMART_TIER2_MODEL=gemini-3.1-pro-preview
# SMART_CV_CONF_THRESHOLD=0.85
# SMART_MAX_TIER2_FIELDS=8
